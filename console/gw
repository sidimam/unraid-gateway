#!/bin/sh
# unraid-gateway console helper. Type `gw` for the walkthrough.
API="http://127.0.0.1:${LISTEN_ADDR#:}"; [ "$API" = "http://127.0.0.1:" ] && API="http://127.0.0.1:8484"
ROOT="${DATA_ROOT:-/data}"; CONF="${SHARES_CONFIG:-/unraid-shares/smb-shares.conf}"
bold() { printf '\033[1m%s\033[0m\n' "$*"; }
ok()   { printf '  \033[32m✔\033[0m %s\n' "$*"; }
bad()  { printf '  \033[31m✘\033[0m %s\n' "$*"; }
note() { printf '  · %s\n' "$*"; }
shares() { awk -v r="$ROOT" '$5 != r && index($5, r"/") == 1 { sub(r"/", "", $5); if ($5 !~ /\//) print $5 }' /proc/self/mountinfo 2>/dev/null | sort -u; }

case "${1:-help}" in
  status)
    bold "Gateway"
    H=$(curl -s -m 3 "$API/healthz") && ok "API answering on $API: $H" || bad "API not answering on $API"
    bold "Unraid API (${UNRAID_URL:-unset})"
    C=$(curl -s -m 5 -o /dev/null -w '%{http_code}' -X POST "${UNRAID_URL}/graphql" -H 'Content-Type: application/json' -d '{"query":"{ __typename }"}')
    case "$C" in 200|400|401|403) ok "reachable (HTTP $C)";; 000) bad "unreachable: check UNRAID_URL (use the LAN IP, not localhost)";; *) note "HTTP $C from ${UNRAID_URL}/graphql";; esac
    bold "Shares mounted under $ROOT"
    S=$(shares); [ -n "$S" ] && for s in $S; do
        if touch "$ROOT/$s/.gw-write-test" 2>/dev/null; then rm -f "$ROOT/$s/.gw-write-test"; ok "$s (read/write)"; else ok "$s (read-only)"; fi; done || bad "no share mounted: add Paths /data/<name> in the container settings"
    bold "User authentication: ${USER_AUTH:-optional}"
    if [ "${USER_AUTH:-optional}" != off ]; then
      if [ -r "$CONF" ]; then ok "share config readable ($CONF): $(grep -c '^\[' "$CONF") share definitions"; else bad "share config not readable at $CONF: map /etc/samba/smb-shares.conf (read-only)"; fi
      SMB="${UNRAID_SMB_ADDR:-$(echo "$UNRAID_URL" | sed -E 's#^https?://##; s#[:/].*##'):445}"
      nc -z -w 3 ${SMB%:*} ${SMB#*:} 2>/dev/null && ok "Unraid SMB reachable at $SMB" || bad "Unraid SMB not reachable at $SMB (needed to verify user passwords)"
    fi
    ;;
  shares)
    bold "Mounted shares and who may use them (from $CONF)"
    for s in $(shares); do
      sec=$(awk -v n="$s" 'tolower($0)=="["tolower(n)"]"{f=1;next} /^\[/{f=0} f && /^[[:space:]]*#/{gsub(/^[[:space:]]*#[[:space:]]*/,"");print;exit}' "$CONF" 2>/dev/null)
      wl=$(awk -v n="$s" 'tolower($0)=="["tolower(n)"]"{f=1;next} /^\[/{f=0} f && /write list/{sub(/.*=[[:space:]]*/,"");print;exit}' "$CONF" 2>/dev/null)
      rl=$(awk -v n="$s" 'tolower($0)=="["tolower(n)"]"{f=1;next} /^\[/{f=0} f && /read list/{sub(/.*=[[:space:]]*/,"");print;exit}' "$CONF" 2>/dev/null)
      printf '  %-14s %-8s write: %-40s read: %s\n' "$s" "${sec:-?}" "${wl:-—}" "${rl:-—}"
    done
    note "Public = everyone rw · Secure = everyone ro, write list rw · Private = lists only. Not exported = hidden."
    ;;
  users)
    bold "Unraid users mentioned in share lists"
    grep -hE 'write list|read list|valid users' "$CONF" 2>/dev/null | sed -E 's/.*=//; s/,/ /g' | tr ' ' '\n' | sed '/^$/d' | sort -u | sed 's/^/  · /'
    note "Passwords are verified by Unraid's Samba; test one with: gw login <username>"
    ;;
  login)
    U="$2"; [ -z "$U" ] && { echo "usage: gw login <unraid-username>   (you will be asked for the API key and the password)"; exit 1; }
    printf 'Unraid API key: '; stty -echo 2>/dev/null; read K; stty echo 2>/dev/null; echo
    printf 'Password for %s: ' "$U"; stty -echo 2>/dev/null; read P; stty echo 2>/dev/null; echo
    curl -s -m 20 -X POST "$API/api/v1/auth/login" -H 'Content-Type: application/json' -d "{\"apiKey\":\"$K\",\"username\":\"$U\",\"password\":\"$P\"}" | sed 's/"token":"[^"]*"/"token":"…"/'; echo
    ;;
  key)
    printf 'Unraid API key: '; stty -echo 2>/dev/null; read K; stty echo 2>/dev/null; echo
    curl -s -m 20 -X POST "$API/api/v1/auth/login" -H 'Content-Type: application/json' -d "{\"apiKey\":\"$K\"}" | sed 's/"token":"[^"]*"/"token":"…"/'; echo
    ;;
  activity)
    # Who is connected and what is streaming, straight from the gateway (loopback needs no token).
    if [ "$2" = "-w" ] || [ "$2" = "--watch" ]; then
      while :; do clear; bold "unraid-gateway activity — $(date '+%H:%M:%S')  (Ctrl-C to stop)"; curl -s -m 3 "$API/api/v1/activity?format=text" || bad "API not answering on $API"; sleep 3; done
    else
      bold "Who is connected and what is streaming"
      curl -s -m 3 "$API/api/v1/activity?format=text" || bad "API not answering on $API"
      note "gw activity -w refreshes every 3 s. The web UI (port 8484, after login) shows the same with progress bars."
    fi
    ;;
  devices)
    # Registered app installations. `gw devices rm <id>` revokes one, `gw devices rm all` every one.
    case "$2" in
      rm|remove|delete)
        [ -z "$3" ] && { echo "usage: gw devices rm <device-id|all>"; exit 1; }
        if [ "$3" = all ]; then curl -s -m 5 -X DELETE "$API/api/v1/devices"; echo; else curl -s -m 5 -o /dev/null -w 'HTTP %{http_code}\n' -X DELETE "$API/api/v1/devices/$3"; fi
        note "The apps on those devices will ask to sign in again; that re-registers them and sends a notification." ;;
      *)
        bold "Registered devices"
        curl -s -m 5 "$API/api/v1/devices" | tr '{' '\n' | grep '"id"' | sed -E 's/.*"id":"([^"]*)".*"name":"([^"]*)".*"user":"([^"]*)".*"lastSeen":"([^"]*)".*"lastIp":"([^"]*)".*/  \1  \2  user=\3  last=\4  ip=\5/; s/.*"id":"([^"]*)".*"name":"([^"]*)".*"lastSeen":"([^"]*)".*/  \1  \2  last=\3/' || bad "API not answering on $API"
        note "gw devices rm <id> removes one (its app will ask to sign in again), gw devices rm all removes every device." ;;
    esac
    ;;
  notify-test|notify)
    bold "Sending a test notification on every configured channel"
    curl -s -m 20 -X POST "$API/api/v1/notify/test"; echo
    note "Channels: NOTIFY_UNRAID (Unraid notifications), SMTP_HOST/PORT/USER/PASSWORD/FROM/TO/TLS (e-mail), TELEGRAM_BOT_TOKEN/CHAT_ID."
    ;;
  env)
    env | grep -E '^(UNRAID_URL|USER_AUTH|UNRAID_SMB_ADDR|SHARES_CONFIG|DATA_ROOT|READ_ONLY|TRUST_PROXY|SESSION_TTL|MAX_LOGIN_ATTEMPTS|LOGIN_LOCKOUT|LOG_FORMAT|LOG_LEVEL|TZ|DEVICE_REGISTRATION|DEVICES_FILE|NOTIFY_UNRAID|SMTP_HOST|SMTP_PORT|SMTP_USER|SMTP_FROM|SMTP_TO|SMTP_TLS|TELEGRAM_CHAT_ID|WEBUI_API_KEY_FILE)=' | sort | sed 's/^/  /'
    [ -n "$SMTP_PASSWORD" ] && echo "  SMTP_PASSWORD=(set)"; [ -n "$TELEGRAM_BOT_TOKEN" ] && echo "  TELEGRAM_BOT_TOKEN=(set)"; [ -n "$WEBUI_API_KEY" ] && echo "  WEBUI_API_KEY=(set)"; [ -n "$NOTIFY_UNRAID_API_KEY" ] && echo "  NOTIFY_UNRAID_API_KEY=(set)"
    ;;
  help|*)
    bold "unraid-gateway console — walkthrough"
    cat <<'TXT'
  WHAT THIS IS
  This container is the server side of Unraid Drive: one authenticated HTTPS port that serves the
  shares mapped under /data to the apps (iPhone, iPad, Mac, Vision Pro, Apple TV) and to the web UI
  on port 8484. Nothing is configured here: settings are the container's variables and path
  mappings in Unraid (Docker → unraid-gateway → Edit).

  HOW ACCESS WORKS
  · Every client presents an Unraid API key (Settings → Management Access → API Keys). VIEWER is
    enough for files; ADMIN also unlocks key management in the web UI. Unraid validates the key.
  · With USER_AUTH=optional|required the client may/must add an Unraid username and password:
    Samba verifies them and the gateway applies that user's share security (Public/Secure/Private,
    read/write lists) exactly as over SMB. Without a user, access = the container's mounts.
  · Files the gateway creates get Unraid's standard permissions (nobody:users, 0777/0666).
  · Devices: each app installation registers itself the first time it signs in. The web UI (Devices)
    and `gw devices` list them; removing one closes its sessions and the app asks to sign in again.
  · Notifications: a new or removed device is announced via Unraid notifications, e-mail and/or
    Telegram, whichever is configured (`gw notify-test` to try).
  · Media tickets: players that cannot send headers (Infuse, VLC) get a signed, expiring URL per file.
  · The web UI can remember your API key (WEBUI_API_KEY or "Remember this key") for one-click login.

  COMMANDS
  1. gw status       health of the API, Unraid API reachability, mounted shares (rw/ro), user-auth prerequisites
  2. gw shares       each mounted share with its Unraid security (Public/Secure/Private) and user lists
  3. gw users        Unraid users that appear in the share lists
  4. gw login U      try a login as Unraid user U (asks API key + password) and show the resulting permissions
  5. gw key          try a login with the API key only
  6. gw env          the effective configuration variables (secrets shown as "(set)")
  7. gw activity     who is connected (device, user, IP), streams/uploads in progress, recent transfers (-w = live)
  8. gw devices      registered app installations; gw devices rm <id> | rm all revokes them
  9. gw notify-test  send a test notification through every configured channel

  WHERE THINGS LIVE
  /data/<share>              the mounted shares            /config/index.db      file index (safe to delete)
  /config/devices.json       registered devices            /config/webui.key     remembered web UI key (0600)
  /unraid-shares/smb-shares.conf  Unraid share security (read-only mount)

  LOGS: Unraid → Docker → unraid-gateway → Logs. One line per request:
     TIME INFO  METHOD PATH → STATUS in Nms  file=/share/path user=… ip=…
  Common lines: "login ok (user)", "login failed: Unraid rejected the API key", "login refused: device not
  registered", "device registered", "permission denied: the gateway runs as nobody …" (run Tools → New
  Permissions on that share). Health checks hidden (LOG_HEALTHCHECKS=true to see them); LOG_FORMAT=json.

  UPDATES: the Community Applications template uses tag latest (Check for Updates → Update). If Unraid
  keeps saying up-to-date, edit the container and set the Repository to ghcr.io/sidimam/unraid-gateway:X.Y.Z.

  Docs: https://github.com/sidimam/unraid-gateway/wiki
TXT
    ;;
esac
